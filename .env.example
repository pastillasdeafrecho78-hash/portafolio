# Web3Forms — formulario de contacto (desde el navegador, plan gratis)
# Obtén la tuya en https://web3forms.com
# En Vercel: Settings → Environment Variables → NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY
# Aplica a Production + Preview. La key es pública (Web3Forms la diseña así).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# ManyChat — seguimiento automático por WhatsApp (Fase B)
# El token es secreto y solo se usa en el servidor.
NEXT_PUBLIC_MANYCHAT_ENABLED=false
MANYCHAT_API_TOKEN=
MANYCHAT_WELCOME_FLOW_NS=
